{
  "version": 1,
  "author": "Cristian",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 120, "left": -150, "attrs": {"color":"green"}},
    { "type": "wokwi-ds1307", "id": "rtc", "top": 250, "left": 200, "attrs": {}},
    { "type": "wokwi-ili9341", "id": "lcd", "top": -250, "left": 250, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "btn:1.l", "esp:0", "green",       [] ],
    [ "btn:2.l", "esp:GND.1", "black",   [] ],
    
    [ "rtc:GND", "esp:GND.1", "black",   [] ],
    [ "rtc:5V",  "esp:3V3.1", "red",     [] ],
    [ "rtc:SDA", "esp:8", "blue",        [] ],
    [ "rtc:SCL", "esp:9", "yellow",      [] ],

    [ "lcd:VCC",  "esp:3V3.1", "red",    [] ],
    [ "lcd:GND",  "esp:GND.1", "black",  [] ],
    [ "lcd:LED",  "esp:3V3.1", "red",    [] ],
    [ "lcd:CS",   "esp:10",    "orange", [] ],
    [ "lcd:D/C",  "esp:4",     "purple", [] ],
    [ "lcd:RST",  "esp:5",     "white",  [] ],
    [ "lcd:MOSI", "esp:11",    "blue",   [] ],
    [ "lcd:SCK",  "esp:12",    "yellow", [] ]
  ]
}
