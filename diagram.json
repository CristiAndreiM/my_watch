  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 120, "left": -150, "attrs": {"color":"green"}},
    { "type": "wokwi-ds1307", "id": "rtc", "top": 250, "left": 200, "attrs": {}}
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "btn:1.l", "esp:0", "green",       [] ],
